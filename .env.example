# mevius control plane — copy to .env and fill in.

# Required: 256-bit master key (exactly 64 hex characters)
# generate with: openssl rand -hex 32
MEVIUS_MASTER_KEY=

# Required: bearer token for every /api/v1 route except /api/v1/health
# generate with: openssl rand -hex 32
MEVIUS_API_TOKEN=

# Optional: host port for the web UI (default 80)
# MEVIUS_HTTP_PORT=8080

# Optional alternative to configuring OAuth from the Accounts page. Required
# only when an OAuth client below is configured through environment variables.
# This must be the public, browser-reachable origin of Mevius.
# MEVIUS_PUBLIC_URL=http://localhost

# OAuth is optional and token-based connections remain supported. Register the
# matching callback URL with each provider before enabling it:
#   GitHub:     ${MEVIUS_PUBLIC_URL}/api/v1/connections/oauth/callback/github
#   Cloudflare: ${MEVIUS_PUBLIC_URL}/api/v1/connections/oauth/callback/cloudflare
#   Vercel:     ${MEVIUS_PUBLIC_URL}/api/v1/connections/oauth/callback/vercel

# MEVIUS_GITHUB_OAUTH_CLIENT_ID=
# MEVIUS_GITHUB_OAUTH_CLIENT_SECRET=
# MEVIUS_GITHUB_OAUTH_SCOPES=repo workflow delete_repo read:org

# MEVIUS_CLOUDFLARE_OAUTH_CLIENT_ID=
# MEVIUS_CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Set the least-privilege scopes needed by your Cloudflare OAuth client.
# MEVIUS_CLOUDFLARE_OAUTH_SCOPES=

# MEVIUS_VERCEL_OAUTH_CLIENT_ID=
# MEVIUS_VERCEL_OAUTH_CLIENT_SECRET=
# MEVIUS_VERCEL_OAUTH_SLUG=
