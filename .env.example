# mevius control plane — copy to .env and fill in.

# Required: 256-bit master key (exactly 64 hex characters)
# generate with: openssl rand -hex 32
MEVIUS_MASTER_KEY=

# Required: bearer token for every /api/v1 route except /api/v1/health
MEVIUS_API_TOKEN=

# Optional: SQLite database path (default ./mevius.db)
MEVIUS_DB_PATH=./mevius.db

# Optional: HTTP listen address (default :8080)
MEVIUS_ADDR=:8080
